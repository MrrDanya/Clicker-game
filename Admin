<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Админ-панель | Управление лидерами</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at 30% 40%, #1a1a2e, #0f0f1a);
            font-family: -apple-system, 'Segoe UI', 'Roboto', sans-serif;
            padding: 20px;
        }

        .admin-container {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
        }

        /* Шапка */
        .header {
            background: linear-gradient(135deg, #16213e, #0f0f1a);
            border-radius: 24px;
            padding: 20px 24px;
            margin-bottom: 24px;
            border: 1px solid #e94560;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        .header h1 {
            margin: 0 0 8px 0;
            color: #e94560;
            font-size: 1.8rem;
        }
        .header p {
            margin: 0;
            color: #8f9bb3;
            font-size: 0.9rem;
        }

        /* Сетка */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .card {
            background: #1a1a2e;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #2a2a4a;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .card h3 {
            margin: 0 0 16px 0;
            color: #e94560;
            font-size: 1.2rem;
            border-left: 4px solid #e94560;
            padding-left: 12px;
        }

        /* Таблица лидеров */
        .leader-table {
            width: 100%;
            border-collapse: collapse;
        }
        .leader-table th,
        .leader-table td {
            padding: 12px 10px;
            text-align: left;
            border-bottom: 1px solid #2a2a4a;
            color: #c4c4d4;
        }
        .leader-table th {
            color: #e94560;
            font-weight: bold;
            border-bottom: 2px solid #e94560;
        }
        .leader-table tr:hover {
            background: #252540;
        }

        .edit-input {
            background: #0f0f1a;
            border: 1px solid #e94560;
            border-radius: 8px;
            padding: 6px 10px;
            color: white;
            width: 100px;
            font-family: monospace;
        }
        .save-btn {
            background: #e94560;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            color: white;
            cursor: pointer;
            font-size: 0.75rem;
            margin-right: 5px;
        }
        .delete-btn {
            background: #6b2a3a;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            color: white;
            cursor: pointer;
            font-size: 0.75rem;
        }

        /* Форма добавления */
        .add-form {
            display: flex;
            gap: 10px;
            margin-top: 16px;
            flex-wrap: wrap;
        }
        .add-form input {
            flex: 1;
            background: #0f0f1a;
            border: 1px solid #e94560;
            border-radius: 40px;
            padding: 10px 16px;
            color: white;
        }
        .add-form button {
            background: #e94560;
            border: none;
            border-radius: 40px;
            padding: 10px 24px;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        /* Кнопки действий */
        .action-buttons {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .btn-primary {
            background: #e94560;
            border: none;
            border-radius: 40px;
            padding: 12px 24px;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }
        .btn-secondary {
            background: #2a2a4a;
            border: none;
            border-radius: 40px;
            padding: 12px 24px;
            color: white;
            cursor: pointer;
        }
        .btn-danger {
            background: #6b2a3a;
            border: none;
            border-radius: 40px;
            padding: 12px 24px;
            color: white;
            cursor: pointer;
        }

        /* Поиск */
        .search-box {
            background: #0f0f1a;
            border: 1px solid #2a2a4a;
            border-radius: 40px;
            padding: 10px 20px;
            width: 100%;
            color: white;
            margin-bottom: 16px;
        }

        /* Модальное окно */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: #1a1a2e;
            border-radius: 32px;
            padding: 24px;
            max-width: 400px;
            width: 90%;
            border: 2px solid #e94560;
        }
        .modal-content h3 {
            color: #e94560;
            margin: 0 0 16px 0;
        }
        .modal-content input {
            width: 100%;
            background: #0f0f1a;
            border: 1px solid #e94560;
            border-radius: 40px;
            padding: 12px;
            color: white;
            margin-bottom: 16px;
        }
        .modal-buttons {
            display: flex;
            gap: 12px;
        }
        .modal-buttons button {
            flex: 1;
            padding: 10px;
            border-radius: 40px;
            border: none;
            cursor: pointer;
        }

        .status-msg {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #2a6b4e;
            color: white;
            padding: 12px 24px;
            border-radius: 40px;
            animation: fadeOut 3s forwards;
            z-index: 1000;
        }
        @keyframes fadeOut {
            0% { opacity: 1; }
            70% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #8f9bb3;
        }

        .badge {
            background: #e94560;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.7rem;
            margin-left: 8px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: #e94560;
        }

        hr {
            border-color: #2a2a4a;
            margin: 16px 0;
        }
    </style>
</head>
<body>
<div class="admin-container">
    <div class="header">
        <h1>🥑 Админ-панель | Управление таблицей лидеров</h1>
        <p>Просмотр, редактирование и удаление игроков. Все изменения сохраняются в общую таблицу.</p>
    </div>

    <div class="stats-grid">
        <div class="card">
            <h3>📊 Статистика</h3>
            <div><span class="stat-value" id="totalPlayers">0</span> <span style="color:#8f9bb3;">всего игроков</span></div>
            <div style="margin-top: 8px;"><span class="stat-value" id="totalCoins">0</span> <span style="color:#8f9bb3;">всего монет</span></div>
            <div style="margin-top: 8px;"><span class="stat-value" id="topPlayer">-</span> <span style="color:#8f9bb3;">лидер</span></div>
        </div>
        <div class="card">
            <h3>🎮 Быстрые действия</h3>
            <div class="action-buttons" style="margin-top: 0;">
                <button class="btn-primary" id="refreshBtn">🔄 Обновить таблицу</button>
                <button class="btn-secondary" id="addPlayerBtn">➕ Добавить игрока</button>
                <button class="btn-danger" id="clearAllBtn">⚠️ Очистить всех</button>
            </div>
        </div>
    </div>

    <div class="card">
        <h3>🏆 Таблица лидеров (управление)</h3>
        <input type="text" id="searchInput" class="search-box" placeholder="🔍 Поиск по имени...">
        <div style="overflow-x: auto;">
            <table class="leader-table" id="leaderTable">
                <thead>
                    <tr><th>#</th><th>Имя игрока</th><th>Монеты 🥑</th><th>Действия</th></tr>
                </thead>
                <tbody id="leaderTableBody">
                    <tr><td colspan="4" class="loading">Загрузка...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div style="text-align: center; margin-top: 20px; color: #6b6b8b; font-size: 0.8rem;">
        ⚠️ ВНИМАНИЕ: Все изменения применяются к общей таблице лидеров!<br>
        Редактируйте баланс игроков, удаляйте или добавляйте новых.
    </div>
</div>

<script>
    // ========== НАСТРОЙКИ JSONBIN.IO (те же, что и в игре) ==========
    const BIN_ID = "6a0485ac250b1311c344dc9e";
    const API_KEY = "$2a$10$my.qCD0x0BIW5ej4vxtLF.IoXo3AJq6R5uhspSb1ZfvAeAu7UFHby";
    
    let leadersData = [];
    let searchTerm = "";

    // ========== ЗАГРУЗКА ДАННЫХ ==========
    async function loadLeaders() {
        try {
            const url = `https://api.jsonbin.io/v3/b/${BIN_ID}/latest`;
            const res = await fetch(url, { headers: { "X-Master-Key": API_KEY } });
            if (!res.ok) throw new Error();
            const data = await res.json();
            leadersData = data.record.leaders || [];
            leadersData.sort((a,b) => b.score - a.score);
            updateStats();
            renderTable();
            return leadersData;
        } catch(e) {
            console.error("Ошибка загрузки:", e);
            leadersData = [];
            renderTable();
            return [];
        }
    }

    // ========== СОХРАНЕНИЕ ДАННЫХ ==========
    async function saveLeaders() {
        try {
            const url = `https://api.jsonbin.io/v3/b/${BIN_ID}`;
            const res = await fetch(url, {
                method: "PUT",
                headers: { "Content-Type": "application/json", "X-Master-Key": API_KEY },
                body: JSON.stringify({ leaders: leadersData })
            });
            if (res.ok) {
                showMessage("✅ Данные сохранены!");
                updateStats();
                renderTable();
                return true;
            } else {
                showMessage("❌ Ошибка сохранения!", "error");
                return false;
            }
        } catch(e) {
            showMessage("❌ Ошибка соединения!", "error");
            return false;
        }
    }

    // ========== ОБНОВЛЕНИЕ СТАТИСТИКИ ==========
    function updateStats() {
        document.getElementById("totalPlayers").innerText = leadersData.length;
        const totalCoins = leadersData.reduce((sum, p) => sum + p.score, 0);
        document.getElementById("totalCoins").innerText = totalCoins.toLocaleString();
        if (leadersData.length > 0) {
            document.getElementById("topPlayer").innerHTML = `${leadersData[0].name} (${Math.floor(leadersData[0].score)} 🥑)`;
        } else {
            document.getElementById("topPlayer").innerHTML = "-";
        }
    }

    // ========== ОТРИСОВКА ТАБЛИЦЫ ==========
    function renderTable() {
        const tbody = document.getElementById("leaderTableBody");
        const filtered = leadersData.filter(p => 
            p.name.toLowerCase().includes(searchTerm.toLowerCase())
        );
        
        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="loading">😢 Нет игроков</td></tr>';
            return;
        }

        tbody.innerHTML = "";
        filtered.forEach((player, idx) => {
            const row = tbody.insertRow();
            const rank = leadersData.findIndex(p => p.name === player.name) + 1;
            row.innerHTML = `
                <td style="color: #e94560; font-weight: bold;">${rank}</td>
                <td><strong>${escapeHtml(player.name)}</strong></td>
                <td>
                    <input type="number" id="score_${idx}" value="${Math.floor(player.score)}" class="edit-input" step="100" style="width: 120px;">
                </td>
                <td>
                    <button class="save-btn" onclick="savePlayerScore('${player.name}', ${idx})">💾 Сохранить</button>
                    <button class="delete-btn" onclick="deletePlayer('${player.name}')">🗑 Удалить</button>
                </td>
            `;
        });
    }

    // ========== СОХРАНЕНИЕ СЧЁТА ИГРОКА ==========
    window.savePlayerScore = async function(name, idx) {
        const input = document.getElementById(`score_${idx}`);
        if (!input) return;
        let newScore = parseInt(input.value);
        if (isNaN(newScore)) newScore = 0;
        if (newScore < 0) newScore = 0;
        
        const player = leadersData.find(p => p.name === name);
        if (player) {
            player.score = newScore;
            leadersData.sort((a,b) => b.score - a.score);
            await saveLeaders();
            renderTable();
            showMessage(`💰 ${name}: баланс изменён на ${newScore} 🥑`);
        }
    };

    // ========== УДАЛЕНИЕ ИГРОКА ==========
    window.deletePlayer = async function(name) {
        if (confirm(`Удалить игрока "${name}" из таблицы лидеров?`)) {
            leadersData = leadersData.filter(p => p.name !== name);
            await saveLeaders();
            renderTable();
            showMessage(`🗑 Игрок "${name}" удалён`);
        }
    };

    // ========== ДОБАВЛЕНИЕ ИГРОКА ==========
    function showAddModal() {
        const modal = document.createElement("div");
        modal.className = "modal";
        modal.innerHTML = `
            <div class="modal-content">
                <h3>➕ Добавить игрока</h3>
                <input type="text" id="newPlayerName" placeholder="Имя игрока" maxlength="20">
                <input type="number" id="newPlayerScore" placeholder="Количество монет" value="0" step="100">
                <div class="modal-buttons">
                    <button id="modalConfirmBtn" style="background:#e94560; color:white;">Добавить</button>
                    <button id="modalCancelBtn" style="background:#2a2a4a; color:white;">Отмена</button>
                </div>
            </div>
        `;
        document.body.appendChild(modal);
        
        document.getElementById("modalConfirmBtn").onclick = async () => {
            const name = document.getElementById("newPlayerName").value.trim();
            let score = parseInt(document.getElementById("newPlayerScore").value);
            if (isNaN(score)) score = 0;
            if (name === "") {
                showMessage("❌ Введите имя игрока!", "error");
                return;
            }
            if (leadersData.find(p => p.name === name)) {
                showMessage("❌ Игрок с таким именем уже существует!", "error");
                return;
            }
            leadersData.push({ name: name, score: score });
            leadersData.sort((a,b) => b.score - a.score);
            await saveLeaders();
            renderTable();
            showMessage(`✅ Игрок "${name}" добавлен с балансом ${score} 🥑`);
            modal.remove();
        };
        document.getElementById("modalCancelBtn").onclick = () => modal.remove();
    }

    // ========== ОЧИСТКА ВСЕХ ИГРОКОВ ==========
    async function clearAllPlayers() {
        if (confirm("⚠️ ВНИМАНИЕ! Это удалит ВСЕХ игроков из таблицы лидеров. Продолжить?")) {
            leadersData = [];
            await saveLeaders();
            renderTable();
            showMessage("🗑 Таблица лидеров очищена");
        }
    }

    // ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========
    function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    function showMessage(text, type = "success") {
        const msg = document.createElement("div");
        msg.className = "status-msg";
        msg.style.background = type === "error" ? "#8b3a3a" : "#2a6b4e";
        msg.innerText = text;
        document.body.appendChild(msg);
        setTimeout(() => msg.remove(), 3000);
    }

    // ========== ПОИСК ==========
    document.getElementById("searchInput").addEventListener("input", (e) => {
        searchTerm = e.target.value;
        renderTable();
    });

    // ========== КНОПКИ ==========
    document.getElementById("refreshBtn").onclick = async () => {
        await loadLeaders();
        showMessage("🔄 Таблица обновлена");
    };
    document.getElementById("addPlayerBtn").onclick = showAddModal;
    document.getElementById("clearAllBtn").onclick = clearAllPlayers;

    // ========== ЗАПУСК ==========
    loadLeaders();
</script>
</body>
</html>
